{
  "name": "3mf-placards",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/notwillk/devcontainer-features/openscad-cli:1": {},
    "ghcr.io/notwillk/devcontainer-features/ssh-server": {
      "port": "22"
    }
  },
  "containerEnv": {
    "PATH": "${containerWorkspaceFolder}/tools/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "UV_LINK_MODE": "copy",
    "SSH_PUBLIC_KEY": "${localEnv:SSH_PUBLIC_KEY}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "files.eol": "\n"
      },
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-vscode.makefile-tools",
        "timonwong.shellcheck",
        "foxundermoon.shell-format"
      ]
    }
  },
  "postCreateCommand": "checksy --config verify.checksy.yaml check",
  "appPort": [
    "2223:22"
  ],
  "forwardPorts": [
    22
  ]
}